
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Movie {
  id               String   @id @default(uuid())

  // Identidad en SWAPI.tech
  externalId       String?  @unique
  sourceUrl        String?  @unique

  // Datos propios de la película
  title            String
  episodeId        Int?
  openingCrawl     String?  @db.Text
  director         String?
  producer         String?
  releaseDate      DateTime? @db.Date

  // Relaciones externas representadas como URLs
  characters       String[] @default([])
  planets          String[] @default([])
  starships        String[] @default([])
  vehicles         String[] @default([])
  species          String[] @default([])

  // Fechas informadas por SWAPI
  sourceCreatedAt  DateTime?
  sourceEditedAt   DateTime?

  // Auditoría local
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}